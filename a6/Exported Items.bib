
@article{harrington_back--basics_2021,
	title = {Back-to-Basics tutorial: X-ray diffraction of thin films},
	volume = {47},
	issn = {1573-8663},
	url = {https://doi.org/10.1007/s10832-021-00263-6},
	doi = {10.1007/s10832-021-00263-6},
	shorttitle = {Back-to-Basics tutorial},
	abstract = {X-ray diffraction ({XRD}) is an indispensable tool for characterising thin films of electroceramic materials. For the beginner, however, it can be a daunting technique at first due to the number of operation modes and measurements types, as well as the interpretation of the resultant patterns and scans. In this tutorial article, we provide a foundation for the thin-film engineer/scientist conducting their first measurements using {XRD}. We give a brief introduction of the principle of diffraction and description of the instrument, detailing the relevant operation modes. Next, we introduce five types of measurements essential for thin film characterisation: \$\$2{\textbackslash}theta /{\textbackslash}omega\$\$scans, grazing-incidence scans, rocking curves, pole figures, and azimuth scans (or ϕ scans). Practical guidelines for selecting the appropriate optics, mounting and aligning the sample, and selecting scan conditions are given. Finally, we discuss some of the basics of data analysis, and give recommendations on the presentation of data. The aim of this article is to ultimately lower the barrier for researchers to perform meaningful {XRD} analysis, and, building on this foundation, find the existing literature more accessible, enabling more advanced {XRD} investigations.},
	pages = {141--163},
	number = {4},
	journaltitle = {Journal of Electroceramics},
	shortjournal = {J Electroceram},
	author = {Harrington, George F. and Santiso, José},
	urldate = {2026-07-28},
	date = {2021-12-01},
	langid = {english},
	keywords = {Back-to-Basics, Guidelines, Methodology, Thin films, Tutorial, X-ray diffraction},
	file = {Full Text PDF:/home/simon/Documents/zotero/storage/9WETUPFM/Harrington and Santiso - 2021 - Back-to-Basics tutorial X-ray diffraction of thin films.pdf:application/pdf},
}
